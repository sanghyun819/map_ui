<?xml version="1.0"?>
<robot name="rby1_v1_1">

    <link name="base">
        <inertial>
            <mass value="60.08042639"/>
            <origin rpy="0 0 0" xyz="-0.06157942 -0.00142271 0.13513861"/>
            <inertia
                ixx="1.37742174" ixy="0.02521789" ixz="0.18565467"
                iyy="2.99386515" iyz="-0.00641869" izz="3.76085052"/>
        </inertial>
    </link>

    <link name="wheel_r"/>
    <link name="wheel_l"/>

    <joint name="right_wheel" type="continuous">
        <parent link="base"/>
        <child link="wheel_r"/>
        <origin xyz="0.228 -0.265 0.1" rpy="0.0 0.0 0.0"/>
        <axis xyz="0 -1 0"/>
        <limit effort="1000.0" velocity="15.707963268" acceleration="3.141592"/>
    </joint>

    <joint name="left_wheel" type="continuous">
        <parent link="base"/>
        <child link="wheel_l"/>
        <origin xyz="0.228 0.265 0.1" rpy="0.0 0.0 0.0" />
        <axis xyz="0 -1 0"/>
        <limit effort="1000.0" velocity="15.707963268" acceleration="3.141592"/>
    </joint>

    <link name="link_torso_0"/>
    <link name="link_torso_1"/>
    <link name="link_torso_2"/>
    <link name="link_torso_3"/>
    <link name="link_torso_4"/>
    <link name="link_torso_5"/>

    <joint name="torso_0" type="revolute">
        <parent link="base"/>
        <child link="link_torso_0"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.2805"/>
        <axis xyz="1 0 0"/>
        <limit effort="270.0" acceleration="5.0" velocity="2.09439510"
               lower="-0.261799388" upper="0.261799388"/>
    </joint>

    <joint name="torso_1" type="revolute">
        <parent link="link_torso_0"/>
        <child link="link_torso_1"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <axis xyz="0 1 0"/>
        <limit effort="270.0" acceleration="5.0" velocity="2.09439510"
               lower="-0.523598776" upper="1.570796327"/>
    </joint>

    <joint name="torso_2" type="revolute">
        <parent link="link_torso_1"/>
        <child link="link_torso_2"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.350"/>
        <axis xyz="0 1 0"/>
        <limit effort="270.0" acceleration="5.0" velocity="2.09439510"
               lower="-2.617993878" upper="1.570796327"/>
    </joint>

    <joint name="torso_3" type="revolute">
        <parent link="link_torso_2"/>
        <child link="link_torso_3"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.350"/>
        <axis xyz="0 1 0"/>
        <limit effort="120.0" acceleration="5.0" velocity="3.141592654"
               lower="-0.785398163" upper="1.570796327"/>
    </joint>

    <joint name="torso_4" type="revolute">
        <parent link="link_torso_3"/>
        <child link="link_torso_4"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <axis xyz="1 0 0"/>
        <limit effort="120.0" acceleration="5.0" velocity="3.141592654"
               lower="-0.523598776" upper="0.523598776"/>
    </joint>

    <joint name="torso_5" type="revolute">
        <parent link="link_torso_4"/>
        <child link="link_torso_5"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.309426548461"/>
        <axis xyz="0 0 1"/>
        <limit effort="120.0" acceleration="5.0" velocity="3.141592654"
               lower="-2.35619449" upper="2.35619449"/>
    </joint>

    <link name="link_right_arm_0"/>
    <link name="link_right_arm_1"/>
    <link name="link_right_arm_2"/>
    <link name="link_right_arm_3"/>
    <link name="link_right_arm_4"/>
    <link name="link_right_arm_5"/>
    <link name="link_right_arm_6"/>

    <link name="link_left_arm_0"/>
    <link name="link_left_arm_1"/>
    <link name="link_left_arm_2"/>
    <link name="link_left_arm_3"/>
    <link name="link_left_arm_4"/>
    <link name="link_left_arm_5"/>
    <link name="link_left_arm_6"/>

    <link name="ee_right"/>
    <link name="ee_finger_r1"/>
    <link name="ee_finger_r2"/>
    <link name="ee_left"/>
    <link name="ee_finger_l1"/>
    <link name="ee_finger_l2"/>

    <joint name="tool_right" type="fixed">
        <parent link="link_right_arm_6"/>
        <child link="ee_right"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.1261"/>
        <axis xyz="0 0 1"/>
    </joint>

    <joint name="gripper_finger_r1" type="fixed">
        <parent link="ee_right"/>
        <child link="ee_finger_r1"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.05 0.0 -0.075"/>
        <axis xyz="-1 0 0"/>
    </joint>

    <joint name="gripper_finger_r2" type="fixed">
        <parent link="ee_right"/>
        <child link="ee_finger_r2"/>
        <origin rpy="0.0 0.0 3.1415926535" xyz="-0.05 0.0 -0.075"/>
        <axis xyz="1 0 0"/>
    </joint>

    <joint name="tool_left" type="fixed">
        <parent link="link_left_arm_6"/>
        <child link="ee_left"/>
        <origin rpy="0.0 0.0 0" xyz="0.0 0.0 -0.1261"/>
        <axis xyz="0 0 1"/>
    </joint>

    <joint name="gripper_finger_l1" type="fixed">
        <parent link="ee_left"/>
        <child link="ee_finger_l1"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.05 0.0 -0.075"/>
        <axis xyz="-1 0 0"/>
    </joint>

    <joint name="gripper_finger_l2" type="fixed">
        <parent link="ee_left"/>
        <child link="ee_finger_l2"/>
        <origin rpy="0.0 0.0 3.1415926535" xyz="-0.05 0.0 -0.075"/>
        <axis xyz="1 0 0"/>
    </joint>

    <link name="link_head_0"/>
    <link name="link_head_1"/>
    <link name="link_head_2"/>

    <joint name="head_base" type="fixed">
        <parent link="link_torso_5"/>
        <child link="link_head_0"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.022 0.0 0.120073451525"/>
    </joint>

    <joint name="head_0" type="revolute">
        <parent link="link_head_0"/>
        <child link="link_head_1"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.02"/>
        <axis xyz="0 0 1"/>
        <limit effort="1000" velocity="3.14" lower="-0.523" upper="0.523"/>
    </joint>

    <joint name="head_1" type="revolute">
        <parent link="link_head_1"/>
        <child link="link_head_2"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <axis xyz="0 1 0"/>
        <limit effort="1000" velocity="3.14" lower="-0.35" upper="1.57"/>
    </joint>

    <joint name="right_arm_0" type="revolute">
        <parent link="link_torso_5"/>
        <child link="link_right_arm_0"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 -0.220 0.080073451539 "/>
        <axis xyz="0.0 0.93969262 -0.34202014"/>
        <limit effort="70.0" acceleration="10.0" velocity="3.141592654"
               lower="-3.141592654" upper="3.141592654"/>
    </joint>

    <joint name="right_arm_1" type="revolute">
        <parent link="link_right_arm_0"/>
        <child link="link_right_arm_1"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <axis xyz="1 0 0"/>
        <limit effort="70.0" acceleration="10.0" velocity="3.141592654"
               lower="-3.141592654" upper="0.017453293"/>
    </joint>

    <joint name="right_arm_2" type="revolute">
        <parent link="link_right_arm_1"/>
        <child link="link_right_arm_2"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <axis xyz="0 0 1"/>
        <limit effort="70.0" acceleration="10.0" velocity="3.141592654"
               lower="-3.141592654" upper="3.141592654"/>
    </joint>

    <joint name="right_arm_3" type="revolute">
        <parent link="link_right_arm_2"/>
        <child link="link_right_arm_3"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.031 0.0 -0.276"/>
        <axis xyz="0 1 0"/>
        <limit effort="40.0" acceleration="10.0" velocity="3.141592654"
               lower="-2.617993878" upper="0.017453293"/>
    </joint>

    <joint name="right_arm_4" type="revolute">
        <parent link="link_right_arm_3"/>
        <child link="link_right_arm_4"/>
        <origin rpy="0.0 0.0 0.0" xyz="-0.031 0.0 -0.256"/>
        <axis xyz="0 0 1"/>
        <limit effort="10.0" acceleration="10.0" velocity="6.283185308"
               lower="-3.141592654" upper="3.141592654"/>
    </joint>

    <joint name="right_arm_5" type="revolute">
        <parent link="link_right_arm_4"/>
        <child link="link_right_arm_5"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <axis xyz="0 1 0"/>
        <limit effort="10.0" acceleration="10.0" velocity="6.283185308"
               lower="-1.570796327" upper="1.919862177"/>
    </joint>

    <joint name="right_arm_6" type="revolute">
        <parent link="link_right_arm_5"/>
        <child link="link_right_arm_6"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <axis xyz="0 0 1"/>
        <limit effort="8.0" acceleration="10.0" velocity="2.094395102"
               lower="-2.705260340" upper="2.705260340"/>
    </joint>

    <joint name="left_arm_0" type="revolute">
        <parent link="link_torso_5"/>
        <child link="link_left_arm_0"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.220 0.080073452 "/>
        <axis xyz="0.0 0.93969262 0.34202014"/>
        <limit effort="70.0" acceleration="10.0" velocity="3.141592654"
               lower="-3.141592654" upper="3.141592654"/>
    </joint>

    <joint name="left_arm_1" type="revolute">
        <parent link="link_left_arm_0"/>
        <child link="link_left_arm_1"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <axis xyz="1 0 0"/>
        <limit effort="70.0" acceleration="10.0" velocity="3.141592654"
               lower="-0.017453293" upper="3.141592654"/>
    </joint>

    <joint name="left_arm_2" type="revolute">
        <parent link="link_left_arm_1"/>
        <child link="link_left_arm_2"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <axis xyz="0 0 1"/>
        <limit effort="70.0" acceleration="10.0" velocity="3.141592654"
               lower="-3.141592654" upper="3.141592654"/>
    </joint>

    <joint name="left_arm_3" type="revolute">
        <parent link="link_left_arm_2"/>
        <child link="link_left_arm_3"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.031 0.0 -0.276"/>
        <axis xyz="0 1 0"/>
        <limit effort="40.0" acceleration="10.0" velocity="3.141592654"
               lower="-2.617993878" upper="0.017453293"/>
    </joint>

    <joint name="left_arm_4" type="revolute">
        <parent link="link_left_arm_3"/>
        <child link="link_left_arm_4"/>
        <origin rpy="0.0 0.0 0.0" xyz="-0.031 0.0 -0.256"/>
        <axis xyz="0 0 1"/>
        <limit effort="10.0" acceleration="10.0" velocity="6.283185308"
               lower="-3.141592654" upper="3.141592654"/>
    </joint>

    <joint name="left_arm_5" type="revolute">
        <parent link="link_left_arm_4"/>
        <child link="link_left_arm_5"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <axis xyz="0 1 0"/>
        <limit effort="10.0" acceleration="10.0" velocity="6.283185308"
               lower="-1.570796327" upper="1.919862177"/>
    </joint>

    <joint name="left_arm_6" type="revolute">
        <parent link="link_left_arm_5"/>
        <child link="link_left_arm_6"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <axis xyz="0 0 1"/>
        <limit effort="8.0" acceleration="10.0" velocity="2.094395102"
               lower="-2.705260340" upper="2.705260340"/>
    </joint>

    <!-- Navigation base frame aligned with the former laser_frame pose -->
    <link name="base_nav"/>
    <joint name="base_nav_to_base" type="fixed">
        <parent link="base_nav"/>
        <child link="base"/>
        <origin xyz="-0.228 0 -0.22595" rpy="0 0 0"/>
    </joint>

    <!-- 2D LiDAR frame -->
    <link name="laser_frame"/>
    <joint name="base_nav_to_laser_frame" type="fixed">
        <parent link="base_nav"/>
        <child link="laser_frame"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- camera mount -->
    <link name="camera_head_link"/>
    <joint name="link_head_2_to_camera_head_link" type="fixed">
        <parent link="link_head_2"/>
        <child link="camera_head_link"/>
        <origin xyz="0.002803 0.007924 0.061328" rpy="-0.00118 -0.00183 0.02870" />
    </joint>

    <!-- lidar mount -->
    <link name="livox_lidar">
        <visual>
            <origin xyz="-0.06 0 0.165" rpy="0 0 0"/>
            <geometry>
                <box size="0.36 0.30 0.33"/>
            </geometry>
        </visual>
    </link>
    <joint name="link_torso_5_to_livox_lidar" type="fixed">
        <parent link="link_torso_5"/>
        <child link="livox_lidar"/>
        <origin xyz="-0.037442083 0.002229000 0.325745892" rpy="-3.136562568  0.013624321 -0.00307816"/>
    </joint>

    <!-- Right arm camera mount -->
    <link name="camera_right_link"/>
    <joint name="ee_right_to_camera_right_link" type="fixed">
        <parent link="ee_right"/>
        <child link="camera_right_link"/>
        <origin xyz="0 -0.02 0" rpy="1.570796 1.570796 0"/>
    </joint>

    <!-- Left arm camera mount -->
    <link name="camera_left_link"/>
    <joint name="ee_left_to_camera_left_link" type="fixed">
        <parent link="ee_left"/>
        <child link="camera_left_link"/>
        <origin xyz="0 0.02 0" rpy="1.570796 1.570796 0"/>
    </joint>

    <!-- Right and Left Arm TCP (Tool Center Point) Offsets -->
    <link name="tcp_offset_right"/>
    <joint name="ee_right_to_tcp_offset_right" type="fixed">
        <parent link="ee_right"/>
        <child link="tcp_offset_right"/>
        <origin xyz="0 0 -0.1655" rpy="0 0 0"/>
    </joint>

    <link name="tcp_offset_left"/>
    <joint name="ee_left_to_tcp_offset_left" type="fixed">
        <parent link="ee_left"/>
        <child link="tcp_offset_left"/>
        <origin xyz="0 0 -0.1655" rpy="0 0 0"/>
    </joint>

    <!-- display mount -->
    <link name="display_mount"/>
    <joint name="link_torso_5_to_display_mount" type="fixed">
        <parent link="link_torso_5"/>
        <child link="display_mount"/>
        <origin xyz="0.155 0 0" rpy="0 0 0"/>
    </joint>

</robot>
