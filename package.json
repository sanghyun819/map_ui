{
  "name": "map_ui",
  "private": true,
  "version": "1.0.0",
  "description": "Nav2 map and semantic navigation editor for ROS2",
  "author": {
    "name": "sanghyun819",
    "email": "sh000819@gmail.com"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:preview": "vite build && electron .",
    "robot:server": "node server/robot-backend.cjs",
    "robot:dev": "concurrently -k \"cross-env VITE_ROBOT_BACKEND=1 VITE_USE_POLLING=1 vite --host 0.0.0.0 --port 5173\" \"node server/robot-backend.cjs\""
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "vite": "^8.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "concurrently": "^9.0.0",
    "wait-on": "^8.0.0",
    "cross-env": "^7.0.3"
  },
  "build": {
    "appId": "com.nav2.map-editor",
    "productName": "Nav2 Map Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "beforeBuild": "scripts/electron-before-build.cjs",
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    }
  }
}
